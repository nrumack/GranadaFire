<AnchorPane prefHeight="500.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.granadafire.controller.PlayerSearchController">
   <children>
      <AnchorPane prefHeight="500.0" prefWidth="400.0">
