<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="500.0" style="-fx-background-image: url('file:src/main/resources/views/img/GranadaAlt2.png'); -fx-background-size: cover;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.granadafire.controller.teamControllers.TeamInfoController">
    <children>
        <AnchorPane layoutX="49.0" prefHeight="500.0" prefWidth="400.0" style="-fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.8), 10, 0.0, 0, 2), dropshadow(gaussian, rgba(255, 255, 255, 0.5), 5, 0.0, 0, 0); -fx-background-color: rgba(0, 0, 0, 0.7); -fx-background-radius: 10; -fx-padding: 10;">
            <children>
                <Button layoutX="325.0" layoutY="14.0" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#logout" prefHeight="30.0" prefWidth="70.0" style="-fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-background-color: #000000; -fx-effect: dropshadow(three-pass-box, rgba(255, 255, 255, 0.8), 5, 0.0, 0, 2);" text="Logout" textFill="WHITE" />
                <ListView fx:id="playersInTeam" layoutX="35.0" layoutY="286.0" prefHeight="75.0" prefWidth="360.0" style="-fx-background-radius: 5; -fx-padding: 5;" />
                <Label layoutX="26.0" layoutY="89.0" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Game Name: " />
                <Button layoutX="326.0" layoutY="53.0" mnemonicParsing="false" onAction="#goBackToTeamSearch" prefHeight="30.0" prefWidth="70.0" style="-fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-background-color: #000000; -fx-effect: dropshadow(three-pass-box, rgba(255, 255, 255, 0.8), 5, 0.0, 0, 2);" text="Back" />
                <Button layoutX="292.0" layoutY="372.0" mnemonicParsing="false" onAction="#addAPlayer" prefHeight="30.0" prefWidth="100.0" style="-fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-background-color: #000000; -fx-effect: dropshadow(three-pass-box, rgba(255, 255, 255, 0.8), 5, 0.0, 0, 2);" text="Add player" />
                <Button layoutX="266.0" layoutY="250.0" mnemonicParsing="false" onAction="#removePlayer" prefHeight="30.0" prefWidth="126.0" style="-fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-background-color: #000000; -fx-effect: dropshadow(three-pass-box, rgba(255, 255, 255, 0.8), 5, 0.0, 0, 2);" text="Remove player" />
                <Label layoutX="35.0" layoutY="256.0" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Team players" />
                <ListView fx:id="availablePlayers" layoutX="35.0" layoutY="408.0" prefHeight="75.0" prefWidth="360.0" style="-fx-background-radius: 5; -fx-padding: 5;" />
                <Label layoutX="35.0" layoutY="378.0" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Available players" />
            <TextField fx:id="teamName" layoutX="105.0" layoutY="16.0" prefHeight="25.0" prefWidth="181.0" />
            <Button layoutX="229.0" layoutY="46.0" mnemonicParsing="false" onAction="#editTeamName" style="-fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-background-color: #000000; -fx-effect: dropshadow(three-pass-box, rgba(255, 255, 255, 0.8), 5, 0.0, 0, 2);" text="Update" textFill="WHITE" />
            <TextField fx:id="gameName" layoutX="107.0" layoutY="85.0" prefHeight="26.0" prefWidth="181.0" />
            <ListView fx:id="gamesList" layoutX="107.0" layoutY="118.0" prefHeight="65.0" prefWidth="181.0" style="-fx-background-radius: 5; -fx-padding: 5;" />
            <Button layoutX="231.0" layoutY="191.0" mnemonicParsing="false" onAction="#updateGame" style="-fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-background-color: #000000; -fx-effect: dropshadow(three-pass-box, rgba(255, 255, 255, 0.8), 5, 0.0, 0, 2);" text="Update" />
            <Label layoutX="26.0" layoutY="18.0" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Team name: " />
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
