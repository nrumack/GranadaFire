<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="500.0" prefWidth="500.0" style="-fx-background-image: url('file:src/main/resources/views/img/GranadaAlt2.png'); -fx-background-size: cover;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.granadafire.controller.teamControllers.TeamInfoController">
    <children>
        <AnchorPane layoutX="50.0" prefHeight="500.0" prefWidth="400.0" style="-fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.8), 10, 0.0, 0, 2), dropshadow(gaussian, rgba(255, 255, 255, 0.5), 5, 0.0, 0, 0); -fx-background-color: rgba(0, 0, 0, 0.7); -fx-background-radius: 10; -fx-padding: 10;">
            <children>
                <Label layoutX="140.0" layoutY="7.0" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Edit Team" textAlignment="CENTER">
                    <font>
                        <Font size="36.0" />
                    </font>
                </Label>
                <Button layoutX="330.0" layoutY="14.0" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#logout" prefHeight="19.0" prefWidth="54.0" style="-fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-background-color: #000000; -fx-effect: dropshadow(three-pass-box, rgba(255, 255, 255, 0.8), 5, 0.0, 0, 2);" text="Logout" textFill="WHITE">
                    <font>
                        <Font size="10.0" />
                    </font>
                </Button>
                <ListView fx:id="playersInTeam" layoutX="35.0" layoutY="191.0" prefHeight="125.0" prefWidth="360.0" style="-fx-background-radius: 5; -fx-padding: 5;" />
                <Label layoutX="35.0" layoutY="80.0" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Team Name: " />
                <Label layoutX="35.0" layoutY="110.0" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Game Name: " />
                <Label fx:id="teamName" layoutX="115.0" layoutY="80.0" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label fx:id="gameName" layoutX="115.0" layoutY="110.0" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button layoutX="320.0" layoutY="78.0" mnemonicParsing="false" onAction="#goBackToTeamSearch" prefHeight="30.0" prefWidth="70.0" style="-fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-background-color: #000000; -fx-effect: dropshadow(three-pass-box, rgba(255, 255, 255, 0.8), 5, 0.0, 0, 2);" text="Back" />
                <Button layoutX="289.0" layoutY="325.0" mnemonicParsing="false" onAction="#addAPlayer" prefHeight="30.0" prefWidth="100.0" style="-fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-background-color: #000000; -fx-effect: dropshadow(three-pass-box, rgba(255, 255, 255, 0.8), 5, 0.0, 0, 2);" text="Add player" />
                <Button layoutX="289.0" layoutY="155.0" mnemonicParsing="false" onAction="#removePlayer" prefHeight="30.0" prefWidth="100.0" style="-fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-background-color: #000000; -fx-effect: dropshadow(three-pass-box, rgba(255, 255, 255, 0.8), 5, 0.0, 0, 2);" text="Remove player" />
                <Label layoutX="35.0" layoutY="161.0" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Team players" />
                <ListView fx:id="availablePlayers" layoutX="35.0" layoutY="361.0" prefHeight="125.0" prefWidth="360.0" style="-fx-background-radius: 5; -fx-padding: 5;" />
                <Label layoutX="35.0" layoutY="331.0" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Available players" />
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
