<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.granadafire.controller.teamControllers.TeamSearchController">
   <children>
      <AnchorPane prefHeight="500.0" prefWidth="400.0">
         <children>
            <Label layoutX="132.0" layoutY="28.0" text="Team Search">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <ListView fx:id="teamListView" layoutX="144.0" layoutY="111.0" prefHeight="375.0" prefWidth="242.0" />
            <TextField layoutX="22.0" layoutY="77.0" prefHeight="25.0" prefWidth="268.0" />
            <Button fx:id="searchButton" layoutX="301.0" layoutY="77.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="85.0" style="-fx-background-color: C0BCBC;" text="Search" textFill="WHITE" />
            <Button layoutX="14.0" layoutY="461.0" mnemonicParsing="false" onAction="#clickBackButton" prefHeight="25.0" prefWidth="85.0" style="-fx-background-color: C0BCBC;" text="Back" textFill="WHITE" />
            <Button layoutX="14.0" layoutY="430.0" mnemonicParsing="false" onAction="#createNewTeam" prefHeight="25.0" prefWidth="127.0" style="-fx-background-color: C0BCBC;" text="Create a new team" textFill="WHITE" />
            <Button layoutX="31.0" layoutY="393.0" mnemonicParsing="false" onAction="#deleteTeam" text="Delete team" />
            <Button layoutX="37.0" layoutY="351.0" mnemonicParsing="false" onAction="#editTeam" text="Edit Team" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
