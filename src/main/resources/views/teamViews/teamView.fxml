<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="500.0" prefWidth="500.0"
            style="-fx-background-image: url('file:src/main/resources/views/img/GranadaAlt2.png'); -fx-background-size: cover;"
            xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.granadafire.controller.teamControllers.TeamController">
    <children>
        <AnchorPane layoutX="50.0" prefHeight="500.0" prefWidth="400.0"
                    style="-fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.8), 10, 0.0, 0, 2), dropshadow(gaussian, rgba(255, 255, 255, 0.5), 5, 0.0, 0, 0); -fx-background-color: rgba(0, 0, 0, 0.7); -fx-background-radius: 10; -fx-padding: 10;">
            <children>
                <Label layoutX="96.0" layoutY="14.0" style="-fx-text-fill: white; -fx-font-weight: bold;"
                       text="Create Team" textAlignment="CENTER">
                    <font>
                        <Font size="36.0"/>
                    </font>
                </Label>
                <Button layoutX="330.0" layoutY="14.0" minHeight="-Infinity" minWidth="-Infinity"
                        mnemonicParsing="false" onAction="#logout" prefHeight="19.0" prefWidth="54.0"
                        style="-fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-background-color: #000000; -fx-effect: dropshadow(three-pass-box, rgba(255, 255, 255, 0.8), 5, 0.0, 0, 2);"
                        text="Logout" textFill="WHITE">
                    <font>
                        <Font size="10.0"/>
                    </font>
                </Button>
                <Button layoutX="50.0" layoutY="430.0" mnemonicParsing="false" onAction="#clickBackButton"
                        prefHeight="30.0" prefWidth="100.0"
                        style="-fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-background-color: #000000; -fx-effect: dropshadow(three-pass-box, rgba(255, 255, 255, 0.8), 5, 0.0, 0, 2);"
                        text="Back"/>
                <Button layoutX="250.0" layoutY="430.0" mnemonicParsing="false" onAction="#clickAddTeamButton"
                        prefHeight="30.0" prefWidth="100.0"
                        style="-fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-background-color: #000000; -fx-effect: dropshadow(three-pass-box, rgba(255, 255, 255, 0.8), 5, 0.0, 0, 2);"
                        text="Save"/>
                <TextField fx:id="teamNameBox" layoutX="25.0" layoutY="75.0" prefHeight="17.0" prefWidth="350.0"
                           promptText="Team Name"
                           style="-fx-background-radius: 10; -fx-padding: 5 10 5 10; -fx-background-color: #ffffff; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.5), 5, 0.0, 0, 1);"/>
                <Label layoutX="25.0" layoutY="120.0" text="Assign a game"
                       style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                <ListView fx:id="gameListView" layoutX="21.0" layoutY="150.0" prefHeight="270.0" prefWidth="360.0"
                          style="-fx-background-radius: 5; -fx-padding: 5;"/>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
