<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.granadafire.controller.matchControllers.MatchController" prefHeight="650.0" prefWidth="800.0">
    <children>
        <!-- Centered Content -->
        <VBox alignment="CENTER" spacing="20.0" prefHeight="650.0" prefWidth="800.0">
            <children>
                <!-- Title -->
                <Label text="Matches" style="-fx-font-size: 24px;" />

                <!-- Filter Section -->
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label text="Filter Matches:" />
                        <ComboBox fx:id="filterComboBox" promptText="Select Filter" prefWidth="200.0" />
                    </children>
                </HBox>

                <!-- Match List -->
                <ListView fx:id="matchListView" prefHeight="350.0" prefWidth="700.0" />

                <!-- Update Scores Section -->
                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label text="Update Match Score" style="-fx-font-size: 18px;" />
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Label text="Team 1 Score:" />
                                <TextField fx:id="score1Field" prefWidth="50.0" />
                                <Label text="Team 2 Score:" />
                                <TextField fx:id="score2Field" prefWidth="50.0" />
                                <Button fx:id="updateScoreButton" text="Update Scores" onAction="#updateScore" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Buttons Section -->
                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button fx:id="createMatchButton" text="Create Match" onAction="#createMatch" prefWidth="120.0" />
                        <Button fx:id="deleteMatchButton" text="Delete Match" onAction="#deleteMatch" prefWidth="120.0" />
                        <Button fx:id="goBackButton" text="Back" onAction="#goBack" prefWidth="120.0" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>