<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.granadafire.controller.matchControllers.AddMatchController" prefHeight="600.0" prefWidth="400.0">
    <children>
        <VBox layoutX="50.0" layoutY="20.0" spacing="20.0" alignment="CENTER">
            <Label text="Add New Match" style="-fx-font-size: 20px;" />
            <GridPane hgap="10.0" vgap="15.0">
                <Label text="Match Date:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <DatePicker fx:id="matchDatePicker" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="170.0" />

                <Label text="Time:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <TextField fx:id="matchTimeField" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="HH:mm" prefWidth="170.0" />

                <Label text="Player/Team 1:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <ComboBox fx:id="player1ComboBox" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="170.0" />

                <Label text="Player/Team 2:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <ComboBox fx:id="player2ComboBox" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="170.0" />
            </GridPane>
        </VBox>

        <HBox spacing="20.0" alignment="CENTER" layoutX="100.0" layoutY="500.0">
            <Button fx:id="saveButton" text="Save" onAction="#saveMatch" prefWidth="100.0"/>
            <Button fx:id="backButton" text="Back" onAction="#goBack" prefWidth="100.0"/>
        </HBox>
    </children>
</AnchorPane>