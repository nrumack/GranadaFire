<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="500.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.granadafire.controller.playerControllers.PlayerSearchController">
   <children>
      <AnchorPane prefHeight="500.0" prefWidth="400.0" style="-fx-background-color: #F5F5F5;">
         <children>
            <Label layoutX="154.0" layoutY="14.0" text="Players" textAlignment="CENTER">
               <font>
                  <Font size="30.0" />
               </font>
            </Label>
            <Button fx:id="searchButton" layoutX="310.0" layoutY="60.0" mnemonicParsing="false" onAction="#searchPlayers" prefHeight="30.0" prefWidth="70.0" style="-fx-background-color: #A9A9A9;" text="Search" textFill="WHITE" />
            <Button layoutX="280.0" layoutY="135.0" mnemonicParsing="false" onAction="#filterPlayersByGames" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #A9A9A9;" text="Filter Players" textFill="WHITE" />
            <Button fx:id="backButton" layoutX="280.0" layoutY="170.0" mnemonicParsing="false" onAction="#backButton" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #A9A9A9;" text="Back" textFill="WHITE" />
            <Button fx:id="createNewButton" layoutX="280.0" layoutY="100.0" mnemonicParsing="false" onAction="#createNewButton" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #A9A9A9;" text="Create Player" textFill="WHITE" />
            <Button layoutX="331.0" layoutY="14.0" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#logout" prefHeight="19.0" prefWidth="54.0" style="-fx-background-color: C0BCBC;" text="Logout" textFill="WHITE">
               <font>
                  <Font size="10.0" />
               </font>
            </Button>
            <TextField fx:id="searchField" layoutX="20.0" layoutY="61.0" prefHeight="30.0" prefWidth="280.0" promptText="Search Players..." />
            <ListView fx:id="gameFilterListView" layoutX="20.0" layoutY="100.0" prefHeight="100.0" prefWidth="244.0" />
            <ListView fx:id="playerListView" layoutX="21.0" layoutY="210.0" prefHeight="270.0" prefWidth="360.0" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
