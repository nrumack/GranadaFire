<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="2.0">

    <persistence-unit name="myconfig">
        <class>com.example.granadafire.entities.Team</class>
        <class>com.example.granadafire.entities.Match</class>

        <!-- <class>org.hibernate.example.Book</class> -->
        <class>com.example.granadafire.entities.Game</class>

        <properties>
            <!-- MySQL -->
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost/granadafire/"/>

            <!-- Credentials -->
            <property name="jakarta.persistence.jdbc.user"
                      value="name"/>
            <property name="jakarta.persistence.jdbc.password"
                      value="password"/>

            <!-- Automatic schema export -->
            <!-- <property name="jakarta.persistence.schema-generation.database.action"
                      value="drop-and-create"/> -->
            <property name="hibernate.hbm2ddl" value="update"/>

            <!-- SQL statement logging -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="true"/>
<!--
            <property name="hibernate.dialect" value=" org.hibernate.dialect.MySQLDialect</property>
-->


        </properties>

    </persistence-unit>

</persistence>